# ──────────────────────────────────────────────────────────────────────────────
# Complete Study — environment template
#
# The real (public-by-design) values live in the committed `.env` file.
# Copy this template to `.env.local` to override anything locally —
# `.env.local` is git-ignored and is the right place for secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Firebase web app config
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_CONFIG
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_CONFIG
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_CONFIG
# Optional for Firestore:
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_CONFIG
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_CONFIG
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_CONFIG

# Cloudinary
# Dashboard → Product environment → Cloud name, and Settings → Upload → upload preset.
# The preset must be UNSIGNED (browser uploads don't use the secret API key).
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CONFIG
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_CONFIG

# Admin panel login (file-based login, per project owner's request).
# If unset, the defaults in src/lib/adminAuth.ts apply (test@gmail.com / test@123).
# VITE_ADMIN_EMAIL=
# VITE_ADMIN_PASSWORD=

# Optional — development only. Point the app at a local Firestore emulator,
# e.g. VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:8080
# VITE_FIREBASE_EMULATOR_HOST=
