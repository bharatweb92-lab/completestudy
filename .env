# ──────────────────────────────────────────────────────────────────────────────
# Complete Study — app configuration
#
# This file is COMMITTED to the repository on purpose: every value here is
# public by design and ships inside the production JavaScript bundle anyway
# (Firebase web config, Cloudinary cloud name + unsigned upload preset name).
#
# REAL SECRETS (e.g. the Cloudinary API secret, Firebase service accounts) must
# NEVER be placed in this file — they live only in GitHub Secrets / server
# environments. Local overrides go in .env.local (git-ignored).
# ──────────────────────────────────────────────────────────────────────────────

# Firebase web app config
# (Firebase Console → Project Settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=AIzaSyDwzlYqFF4g59W4jgLVkDS_yZCwbs641Tw
VITE_FIREBASE_AUTH_DOMAIN=completestudy-53623.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=completestudy-53623
VITE_FIREBASE_STORAGE_BUCKET=completestudy-53623.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=492412844346
# appId is optional (only needed for Firebase Analytics etc.) — add it if available:
# VITE_FIREBASE_APP_ID=1:492412844346:web:xxxxxxxxxxxxxxxx

# Cloudinary
# Browser uploads use an UNSIGNED upload preset, so no secret key is needed here.
# The preset "completestudy-certificates" is created/verified by
# .github/workflows/backend-setup.yml (uses the API key/secret stored in GitHub Secrets).
VITE_CLOUDINARY_CLOUD_NAME=h8x01q58
VITE_CLOUDINARY_UPLOAD_PRESET=completestudy-certificates

# Admin panel login (file-based login, per project owner's request).
# Defaults (test@gmail.com / test@123) live in src/lib/adminAuth.ts.
# Override here or in .env.local if needed:
# VITE_ADMIN_EMAIL=
# VITE_ADMIN_PASSWORD=
